# ================================
# ITM Email / SMTP configuration
# ================================
# Keep real credentials only in backend/.env or your secret manager.
# Never commit the real password.

MAIL_ENABLED=true
SMTP_HOST=webmail.fiberathome.net
SMTP_PORT=465
SMTP_TLS_MODE=implicit
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=CHANGE_ME
SMTP_FROM_NAME=ITM Service Desk

# Used for buttons inside email templates.
APP_PUBLIC_URL=http://localhost:5173

# Background outbox worker tuning.
MAIL_WORKER_POLL_SECONDS=2
MAIL_MAX_ATTEMPTS=5
MAIL_SEND_TIMEOUT_SECONDS=20
