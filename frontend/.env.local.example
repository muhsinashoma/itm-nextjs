# ============================================================
# HRIS LIVE EMPLOYEE IMAGE
# ============================================================
#
# No local employee-image folder is required.
#
# Example A:
# DB/API picture value:
#   uploads/employee/02-0046.jpg
#
# HRIS_IMAGE_BASE_URL=https://hris.example.com/
#
# Example B:
# DB/API picture value:
#   02-0046.jpg
#
# HRIS_IMAGE_BASE_URL=https://hris.example.com/uploads/employee/
#
# Allowed hosts are hostnames only, comma-separated.
# Example:
# HRIS_IMAGE_ALLOWED_HOSTS=hris.example.com
#
# If HRIS employee photos require a bearer token, set it below.
# Otherwise keep blank.

HRIS_IMAGE_BASE_URL=
HRIS_IMAGE_ALLOWED_HOSTS=
HRIS_IMAGE_AUTH_TOKEN=
