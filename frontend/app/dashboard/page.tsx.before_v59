                                                    0
                                                }
                                            />
                                        </linearGradient>

                                        <linearGradient
                                            id="g2"
                                            x1="0"
                                            y1="0"
                                            x2="0"
                                            y2="1"
                                        >
                                            <stop
                                                offset="5%"
                                                stopColor="#10b981"
                                                stopOpacity={
                                                    0.2
                                                }
                                            />

